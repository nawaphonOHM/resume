{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "packageManager": "npm",
    "analytics": "d4cb6a4d-6870-4b0d-b3fb-a9e44dc4b5cf"
  },
  "newProjectRoot": "projects",
  "projects": {
    "resume": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "",
      "sourceRoot": "src",
      "prefix": "app",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "inlineStyleLanguage": "scss",
            "styles": ["src/material-theme.scss", "src/styles.scss"]
          },
          "configurations": {
            "production": {
              "fileReplacements": [
                {
                  "replace": "src/bootstrap/startup-config.ts",
                  "with": "src/bootstrap/startup-config.production.ts"
                }
              ],
              "externalDependencies": [
                "@angular/cdk/a11y",
                "@angular/cdk/bidi",
                "@angular/cdk/coercion",
                "@angular/cdk/keycodes",
                "@angular/cdk/layout",
                "@angular/cdk/observers/private",
                "@angular/cdk/overlay",
                "@angular/cdk/platform",
                "@angular/cdk/portal",
                "@angular/cdk/private",
                "@angular/cdk/scrolling",
                "@angular/compiler",
                "@angular/core",
                "@angular/core/primitives/signals",
                "@angular/core/rxjs-interop",
                "@angular/common",
                "@angular/common/http",
                "@angular/platform-browser",
                "rxjs",
                "rxjs/operators"
              ],
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "500kB",
                  "maximumError": "1MB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ],
              "outputHashing": "all"
            },
            "development": {
              "optimization": false,
              "extractLicenses": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": {
              "buildTarget": "resume:build:production"
            },
            "development": {
              "buildTarget": "resume:build:development"
            }
          },
          "defaultConfiguration": "development"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "exclude": ["src/fallback/**/*.spec.ts"]
          }
        }
      }
    },
    "fallback": {
      "projectType": "application",
      "schematics": {
        "@schematics/angular:component": {
          "style": "scss"
        }
      },
      "root": "src/fallback",
      "sourceRoot": "src/fallback",
      "prefix": "fallback",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/fallback/main.ts",
            "tsConfig": "tsconfig.fallback.json",
            "inlineStyleLanguage": "scss",
            "outputPath": {
              "base": "dist/resume/browser/fallback",
              "browser": ""
            },
            "index": false,
            "styles": [],
            "outputHashing": "none",
            "extractLicenses": false
          },
          "configurations": {
            "production": {
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "250kB",
                  "maximumError": "500kB"
                },
                {
                  "type": "anyComponentStyle",
                  "maximumWarning": "4kB",
                  "maximumError": "8kB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true
            }
          },
          "defaultConfiguration": "production"
        },
        "test": {
          "builder": "@angular/build:unit-test",
          "options": {
            "buildTarget": "fallback:build:development",
            "tsConfig": "tsconfig.fallback.spec.json",
            "include": ["**/*.spec.ts"]
          }
        }
      }
    }
  }
}
