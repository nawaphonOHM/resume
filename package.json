{
  "name": "resume",
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run pdf:generate && npm run build:app",
    "build:app": "ng build",
    "pdf": "npm run pdf:generate",
    "pdf:generate": "node tools/generate-resume-pdf.mjs",
    "watch": "ng build --watch --configuration development",
    "test": "npm run test:app -- --watch=false && npm run test:pdf",
    "test:app": "ng test",
    "test:pdf": "node --test tools/*.spec.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.1.0",
    "@angular/common": "^22.1.0",
    "@angular/compiler": "^22.1.0",
    "@angular/core": "^22.1.0",
    "@angular/forms": "^22.1.0",
    "@angular/material": "^22.1.1",
    "@angular/platform-browser": "^22.1.0",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.2",
    "@angular/cli": "^22.1.3",
    "@angular/compiler-cli": "^22.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "jsdom": "^30.0.1",
    "pdfmake": "^0.3.11",
    "prettier": "^3.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": ">=22.22.3"
  }
}
