{
  "name": "resume",
  "version": "4.4.7",
  "type": "module",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "build": "npm run angular:check-format && npm run angular:lint && npm run angular:test-via-ci && npm run angular:build-production",
    "angular:build-production": "ng build --configuration production",
    "angular:check-format": "prettier --check .",
    "angular:test-via-ci": "ng test --watch=false",
    "angular:test-via-not-ci": "ng build --watch --configuration development",
    "angular:do-format": "prettier --write .",
    "angular:lint": "ng lint"
  },
  "private": true,
  "packageManager": "npm@10.9.8",
  "dependencies": {
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@eslint/js": "^10.0.1",
    "@tailwindcss/postcss": "^4.3.3",
    "angular-eslint": "22.5.0",
    "eslint": "^10.9.1",
    "jsdom": "^30.1.0",
    "prettier": "^3.9.7",
    "skott": "^0.35.11",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "8.69.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": "22.x",
    "npm": "10.9.8"
  }
}
